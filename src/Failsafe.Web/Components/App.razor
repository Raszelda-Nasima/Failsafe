@rendermode InteractiveServer
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <base href="/" />
    <link rel="stylesheet" href="css/theme.css" />
    <link rel="stylesheet" href="Failsafe.Web.styles.css" />
    <HeadOutlet />
</head>
<body>
    <!--
        Setting @@rendermode ONCE here, on <Routes>, applies InteractiveServer
        to the ENTIRE routed component tree from the very first request —
        every page and its layout are consistently interactive from the
        start. This replaces per-page @@rendermode declarations entirely,
        which is what caused the sidebar's inconsistent interactivity.
    -->
    <Routes />
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
