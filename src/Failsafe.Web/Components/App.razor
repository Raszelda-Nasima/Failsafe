<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="js/charts.js"></script>
    <base href="/" />
    <link rel="stylesheet" href="css/theme.css" />
    <link rel="stylesheet" href="Failsafe.Web.styles.css" />
    <HeadOutlet />
</head>
<body>
    <!--
        The 'rendermode' attribute is applied directly to the <Routes> tag
        itself (not as a stray line elsewhere in the file) — this is what
        actually activates InteractiveServer for the whole routed
        component tree, from the very first request.
    -->
    <Routes @rendermode="InteractiveServer" />

    <!--
        blazor.web.js, not blazor.server.js — this project uses the
        unified "Blazor Web App" template, which requires this specific
        script to correctly handle the static-to-interactive render
        transition. blazor.server.js is the older, pre-.NET 8 script and
        is incompatible with this template's render-mode model.
    -->
    <script src="_framework/blazor.web.js"></script>
</body>
</html>